{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "武汉旅行规划索引 v2",
  "type": "object",
  "required": [
    "版本",
    "片区",
    "地点",
    "原目的地",
    "参考路线",
    "待识别线索",
    "地图发现候选"
  ],
  "properties": {
    "版本": {
      "const": "2.0"
    },
    "片区": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "编号",
          "名称",
          "三镇",
          "子目的地"
        ],
        "properties": {
          "三镇": {
            "enum": [
              "汉口",
              "武昌",
              "汉阳"
            ]
          },
          "子目的地": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "编号",
                "名称",
                "地点"
              ],
              "properties": {
                "地点": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "地点编号",
                      "关联状态"
                    ],
                    "properties": {
                      "地点编号": {
                        "type": "string",
                        "pattern": "^P[0-9]+$"
                      },
                      "关联状态": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "地点": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "编号",
          "名称",
          "类别",
          "原资料路径",
          "高德",
          "来源",
          "行程状态"
        ],
        "properties": {
          "编号": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "名称": {
            "type": "string"
          },
          "类别": {
            "type": "string"
          },
          "行程状态": {
            "enum": [
              "候选",
              "必去",
              "排除"
            ]
          },
          "高德": {
            "type": "object",
            "required": [
              "POI编号",
              "链接",
              "地址",
              "坐标",
              "坐标系",
              "营业时间",
              "营业状态",
              "查询日期",
              "匹配状态"
            ],
            "properties": {
              "坐标": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "经度",
                      "纬度"
                    ],
                    "properties": {
                      "经度": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "纬度": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    }
                  }
                ]
              },
              "坐标系": {
                "enum": [
                  null,
                  "GCJ-02",
                  "WGS84",
                  "BD-09"
                ]
              }
            }
          },
          "来源": {
            "type": "array"
          }
        }
      }
    },
    "双年展行程": {
      "$ref": "#/$defs/双年展行程"
    }
  },
  "$defs": {
    "地点编号": { "type": "string", "pattern": "^P[0-9]+$" },
    "片区编号": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
    "餐饮编号": { "type": "string", "pattern": "^[A-G]-[0-9]{2}$" },
    "来源": {
      "type": "object",
      "required": ["名称", "链接", "类型", "依据"],
      "properties": {
        "名称": { "type": "string", "minLength": 1 },
        "链接": { "type": "string", "format": "uri" },
        "类型": { "enum": ["官方", "转载", "媒体"] },
        "依据": { "type": "string", "minLength": 1 }
      }
    },
    "餐饮门店": {
      "type": "object",
      "required": ["编号", "名称", "类别", "目的地编号", "位置提示", "建议时段", "点单建议", "高德链接", "核对状态", "来源"],
      "properties": {
        "编号": { "$ref": "#/$defs/餐饮编号" },
        "名称": { "type": "string", "minLength": 1 },
        "类别": { "enum": ["过早", "小吃", "简餐", "正餐", "咖啡"] },
        "目的地编号": { "type": "string", "pattern": "^[A-G]-[1-9][0-9]*$" },
        "位置提示": { "type": "string", "minLength": 1 },
        "建议时段": { "type": "string", "minLength": 1 },
        "点单建议": { "type": "string", "minLength": 1 },
        "高德链接": { "type": "string", "format": "uri" },
        "核对状态": { "type": "string", "minLength": 1 },
        "来源": { "type": "array", "items": { "$ref": "#/$defs/来源" } },
        "原地点编号": { "$ref": "#/$defs/地点编号" },
        "备注": { "type": "string" }
      }
    },
    "行程分段": {
      "type": "object",
      "required": ["片区编号", "时段", "地点编号", "活动", "餐饮编号"],
      "properties": {
        "片区编号": { "$ref": "#/$defs/片区编号" },
        "时段": { "type": "string", "minLength": 1 },
        "地点编号": {
          "type": "array",
          "items": { "$ref": "#/$defs/地点编号" },
          "uniqueItems": true
        },
        "活动": { "type": "string", "minLength": 1 },
        "餐饮编号": {
          "type": "array",
          "items": { "$ref": "#/$defs/餐饮编号" },
          "uniqueItems": true
        }
      }
    },
    "展览": {
      "type": "object",
      "required": ["名称", "展期", "开放", "购票", "票务核对", "场馆", "来源"],
      "properties": {
        "名称": { "type": "string", "minLength": 1 },
        "展期": {
          "type": "array",
          "items": { "type": "string", "format": "date" },
          "minItems": 2,
          "maxItems": 2
        },
        "开放": { "type": "string", "minLength": 1 },
        "购票": { "type": "string", "minLength": 1 },
        "票务核对": { "type": "string", "minLength": 1 },
        "场馆": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["名称", "片区编号", "地址", "状态"],
            "properties": {
              "名称": { "type": "string", "minLength": 1 },
              "片区编号": { "$ref": "#/$defs/片区编号" },
              "地点编号": { "$ref": "#/$defs/地点编号" },
              "地址": { "type": "string", "minLength": 1 },
              "状态": { "type": "string", "minLength": 1 }
            }
          }
        },
        "来源": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/来源" } }
      }
    },
    "双年展行程": {
      "type": "object",
      "required": [
        "名称", "核对日期", "天数", "晚数", "建议住宿", "日期安排",
        "优先地点", "排除地点", "餐饮片区", "展览", "每日", "已核对步行", "出行提示", "来源"
      ],
      "properties": {
        "名称": { "type": "string", "minLength": 1 },
        "核对日期": { "type": "string", "format": "date" },
        "天数": { "const": 5 },
        "晚数": { "const": 4 },
        "每日出门": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "建议住宿": { "type": "string", "minLength": 1 },
        "日期安排": { "type": "string", "minLength": 1 },
        "优先地点": {
          "type": "array",
          "items": { "$ref": "#/$defs/地点编号" },
          "uniqueItems": true
        },
        "排除地点": {
          "type": "array",
          "items": { "$ref": "#/$defs/地点编号" },
          "uniqueItems": true
        },
        "餐饮片区": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["片区编号", "门店"],
            "properties": {
              "片区编号": { "$ref": "#/$defs/片区编号" },
              "门店": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/餐饮门店" }
              }
            }
          }
        },
        "展览": { "$ref": "#/$defs/展览" },
        "每日": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["第几天", "主题", "分段", "调整"],
            "properties": {
              "第几天": { "type": "integer", "minimum": 1, "maximum": 5 },
              "主题": { "type": "string", "minLength": 1 },
              "往返": {
                "type": "object",
                "required": ["去程", "回程"],
                "properties": {
                  "去程": { "type": "string", "minLength": 1 },
                  "回程": { "type": "string", "minLength": 1 }
                }
              },
              "分段": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/行程分段" }
              },
              "调整": { "type": "string", "minLength": 1 }
            }
          }
        },
        "已核对步行": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["起点", "终点", "规划预留分钟"],
            "properties": {
              "起点": { "type": "string", "minLength": 1 },
              "终点": { "type": "string", "minLength": 1 },
              "规划预留分钟": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "出行提示": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "来源": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/来源" } }
      }
    }
  }
}
