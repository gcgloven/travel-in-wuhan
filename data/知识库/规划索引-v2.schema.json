{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "武汉旅行规划索引 v2",
  "type": "object",
  "required": [
    "版本",
    "片区",
    "地点",
    "原目的地",
    "参考路线",
    "待识别线索",
    "地图发现候选"
  ],
  "properties": {
    "版本": {
      "const": "2.0"
    },
    "片区": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "编号",
          "名称",
          "三镇",
          "子目的地"
        ],
        "properties": {
          "三镇": {
            "enum": [
              "汉口",
              "武昌",
              "汉阳"
            ]
          },
          "子目的地": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "编号",
                "名称",
                "地点"
              ],
              "properties": {
                "地点": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "地点编号",
                      "关联状态"
                    ],
                    "properties": {
                      "地点编号": {
                        "type": "string",
                        "pattern": "^P[0-9]+$"
                      },
                      "关联状态": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "地点": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "编号",
          "名称",
          "类别",
          "原资料路径",
          "高德",
          "来源",
          "行程状态"
        ],
        "properties": {
          "编号": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "名称": {
            "type": "string"
          },
          "类别": {
            "type": "string"
          },
          "行程状态": {
            "enum": [
              "候选",
              "必去",
              "排除"
            ]
          },
          "高德": {
            "type": "object",
            "required": [
              "POI编号",
              "链接",
              "地址",
              "坐标",
              "坐标系",
              "营业时间",
              "营业状态",
              "查询日期",
              "匹配状态"
            ],
            "properties": {
              "坐标": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "经度",
                      "纬度"
                    ],
                    "properties": {
                      "经度": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "纬度": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    }
                  }
                ]
              },
              "坐标系": {
                "enum": [
                  null,
                  "GCJ-02",
                  "WGS84",
                  "BD-09"
                ]
              }
            }
          },
          "来源": {
            "type": "array"
          }
        }
      }
    }
  }
}
